{
  "version": "1.0.0",
  "description": "Real-time collaborative text editing backend with a hand-written RGA CRDT, offline editing, history/revert and presence",
  "keywords": ["crdt", "collaborative-editing", "real-time", "websocket", "nodejs", "postgresql", "offline-first"],
  "author": "Suhani",
  "type": "module",
  "scripts": {
    "start": "node src/server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "bench": "node scripts/latency.js",
    "demo": "node scripts/demo.js",
    "app:up": "docker compose --profile app up -d --build --wait",
    "app:down": "docker compose --profile app down"
  },
  "license": "MIT",
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/suhanipaliwal8/collab-sync-engine.git" },
  "bugs": { "url": "https://github.com/suhanipaliwal8/collab-sync-engine/issues" },
  "homepage": "https://github.com/suhanipaliwal8/collab-sync-engine#readme",
  "dependencies": {
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  }
}
